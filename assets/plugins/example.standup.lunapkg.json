{
  "skills": [],
  "capabilities": ["user.ask"],
  "author": "Luna examples",
  "format": 1,
  "name": "Daily standup",
  "description": "A workflow that asks you three questions and writes the answer up as a standup note.",
  "id": "example.standup",
  "workflows": [{
    "nodes": [
      {
        "next": "today",
        "id": "yesterday",
        "type": "human_input",
        "config": {
          "as": "yesterday",
          "question": "What did you finish since the last standup?",
          "required": true
        }
      },
      {
        "next": "blocked",
        "id": "today",
        "type": "human_input",
        "config": {
          "as": "today",
          "question": "What are you doing today?",
          "required": true
        }
      },
      {
        "next": "stuck",
        "id": "blocked",
        "type": "human_input",
        "config": {
          "as": "blocked",
          "question": "Anything blocking you? Say no if not.",
          "required": false
        }
      },
      {
        "whenFalse": "write",
        "id": "stuck",
        "whenTrue": "clear",
        "type": "condition",
        "config": {"when": "blocked contains no"}
      },
      {
        "next": "write",
        "id": "clear",
        "type": "transform",
        "config": {
          "op": "trim",
          "as": "blocked",
          "value": "nothing is blocking me"
        }
      },
      {
        "next": "done",
        "id": "write",
        "type": "llm",
        "config": {
          "as": "note",
          "prompt": "Write a standup note of at most four sentences, in the first person, plainly. Done: {{yesterday}}. Today: {{today}}. Blocked: {{blocked}}. Do not add anything that was not said."
        }
      },
      {
        "id": "done",
        "type": "end",
        "config": {"message": "{{note}}"}
      }
    ],
    "name": "Write my standup",
    "start": "yesterday",
    "description": "Three questions, then one tidy paragraph you can paste anywhere.",
    "maxSteps": 10,
    "id": "example.standup.note",
    "version": "1.0.0"
  }],
  "version": "1.0.0",
  "signing": {
    "signature": "",
    "digest": "cbec19d5325a28b169590b58112e9f2910f2195bda4d402b07e6fd717867e626",
    "publicKey": ""
  },
  "agents": []
}
