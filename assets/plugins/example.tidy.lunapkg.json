{
  "skills": [{
    "instructions": "When you create or rename a file, use lower case with hyphens, no spaces, and put the date first as YYYY-MM-DD when the file is dated. Never invent an extension the contents do not match. If a name already exists, say so instead of overwriting it.",
    "name": "Naming files",
    "description": "How this person likes files named.",
    "id": "example.tidy.naming",
    "triggers": [
      "rename",
      "name",
      "tidy",
      "organise",
      "organize"
    ],
    "tools": [
      "write_file",
      "rename_file",
      "create_file"
    ],
    "requires": ["workspace"],
    "order": 45
  }],
  "capabilities": ["filesystem.read"],
  "author": "Luna examples",
  "format": 1,
  "name": "Tidy folder",
  "description": "Knowledge about naming and organising files, and a workflow that reads a folder and reports what is in it.",
  "id": "example.tidy",
  "workflows": [{
    "nodes": [
      {
        "next": "describe",
        "id": "list",
        "type": "tool",
        "config": {
          "args": {"path": ""},
          "as": "listing",
          "tool": "list_files"
        }
      },
      {
        "next": "done",
        "id": "describe",
        "type": "llm",
        "config": {
          "as": "summary",
          "prompt": "Here is a folder listing:\n\n{{listing}}\n\nIn one short paragraph, say what this folder appears to be for and name the two or three files that matter most. Do not guess at contents you cannot see."
        }
      },
      {
        "id": "done",
        "type": "end",
        "config": {"message": "{{summary}}"}
      }
    ],
    "name": "Survey this folder",
    "start": "list",
    "description": "Lists the granted folder and writes one paragraph about what it holds.",
    "maxSteps": 8,
    "id": "example.tidy.survey",
    "version": "1.0.0"
  }],
  "version": "1.0.0",
